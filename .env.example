NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SECURITY_STEPUP_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES_AND_KEEP_SERVER_ONLY

# Vercel Cron bearer secret; set for Production (and Preview only if cron proof is needed there).
CRON_SECRET=GENERATE_A_LONG_RANDOM_SERVER_ONLY_SECRET

# Exact HTTPS origin of the CURRENT frontend (no trailing path).
# Configure the appropriate origin in Vercel and in all three Supabase Edge Functions:
# invite-farmer, invite-advisor, send-notification-email.
# Also add the exact /invite URL to Supabase Auth > URL Configuration > Redirect URLs.
APP_PUBLIC_ORIGIN=https://your-current-domain.example

# Public Agrár Mentor contact inbox. Use the approved address for this project,
# not the Water-K or Shoperation support address. Without it, the public CTA
# clearly says that email contact is not yet configured.
AGRAR_CONTACT_EMAIL=
